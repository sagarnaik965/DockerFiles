apiVersion: apps/v1
kind: Deployment
metadata:
  name: connt-8088
  namespace: default
  labels:
    app: connt-8088
spec:
  replicas: 1   # HPA will manage this
  selector:
    matchLabels:
      app: connt-8088
  template:
    metadata:
      labels:
        app: connt-8088
    spec:
      containers:
        - name: connt
          image: adv:v451
          imagePullPolicy: IfNotPresent

          env:
            - name: TZ
              value: Asia/Kolkata
            - name: JAVA_OPTS
              value: "-Duser.timezone=Asia/Kolkata"

          ports:
            - name: http-8081
              containerPort: 8080
              hostPort: 8088

          resources:
            requests:
              cpu: 500m
              memory: 1Gi
            limits:
              cpu: 900m
              memory: 4Gi

          readinessProbe:
            httpGet:
              path: /
              port: 8080
            initialDelaySeconds: 90

          livenessProbe:
            httpGet:
              path: /
              port: 8080
            initialDelaySeconds: 90

          volumeMounts:
            - name: webapps-vol
              mountPath: /usr/appserver/tomcat/webapps
            - name: logs-vol
              mountPath: /opt/appdata/logs
            - name: conf-vol
              mountPath: /usr/appserver/tomcat/conf
            - name: localtime
              mountPath: /etc/localtime
              readOnly: true

      volumes:
        - name: webapps-vol
          hostPath:
            path: /opt/appdata/adv-connector/webapps
            type: Directory
        - name: logs-vol
          hostPath:
            path: /opt/appdata/adv-connector/logs
            type: Directory
        - name: conf-vol
          hostPath:
            path: /opt/appdata/adv-connector/conf
            type: Directory
        - name: localtime
          hostPath:
            path: /etc/localtime
            type: File

---
apiVersion: v1
kind: Service
metadata:
  name: connt-8088
  namespace: default
spec:
  type: ClusterIP
  selector:
    app: connt-8088
  ports:
    - name: http
      port: 8080
      targetPort: 8080
      # In-cluster: http://connt-8088:8080
      # External:    http://<node-ip>:8081 (via hostPort)

---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: connt-8088-hpa
  namespace: default
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: connt-8088
  minReplicas: 1
  maxReplicas: 5
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 60
